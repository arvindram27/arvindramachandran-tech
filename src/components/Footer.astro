---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p class="font-mono text-xs text-muted">
      © {year} {site.name} · {site.domain}
    </p>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-sm text-muted sm:text-base">
      <span>Built with</span>
      <span class="inline-flex items-center gap-1.5 text-ink/80">
        <svg
          class="h-4 w-4 shrink-0 text-muted sm:h-5 sm:w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={iconPaths.astro} />
        </svg>
        <span>{site.footer.builtWith}</span>
      </span>
      <span aria-hidden="true">·</span>
      <span>deployed on</span>
      <span class="inline-flex items-center gap-1.5 text-ink/80">
        <svg
          class="h-4 w-4 shrink-0 text-muted sm:h-5 sm:w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={iconPaths.cloudflare} />
        </svg>
        <span>{site.footer.deployedOn}</span>
      </span>
    </p>
  </div>
</footer>
