---
import { site } from "../data/site";
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-3 sm:hidden">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 font-display text-sm font-semibold tracking-tight text-ink"
        aria-label={`${site.name} — home`}
      >
        <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 64 64" fill="none">
          <polyline
            points="6,44 16,38 24,42 32,30 40,36 48,20 58,26"
            stroke="currentColor"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"></polyline>
          <circle cx="48" cy="20" r="8" fill="#B45309"></circle>
        </svg>
        <span>{site.name}</span>
      </a>
      <a
        href={site.resumePath}
        class="shrink-0 rounded-sm border border-accent px-2.5 py-1.5 text-sm font-medium text-accent hover:bg-accent hover:text-paper"
      >
        Resume
      </a>
    </div>

    <div class="hidden h-16 items-center justify-between gap-3 sm:flex">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 font-display text-sm font-semibold tracking-tight text-ink"
        aria-label={`${site.name} — home`}
      >
        <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 64 64" fill="none">
          <polyline
            points="6,44 16,38 24,42 32,30 40,36 48,20 58,26"
            stroke="currentColor"
            stroke-width="6"
            stroke-linecap="round"
            stroke-linejoin="round"></polyline>
          <circle cx="48" cy="20" r="8" fill="#B45309"></circle>
        </svg>
        <span>{site.name}</span>
      </a>
      <nav aria-label="Main" class="flex items-center justify-end gap-x-6">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class="text-sm text-muted underline-offset-4 hover:text-ink hover:underline hover:decoration-accent hover:decoration-2"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={site.resumePath}
          class="rounded-sm border border-accent px-2.5 py-1.5 text-sm font-medium text-accent hover:bg-accent hover:text-paper"
        >
          Resume
        </a>
      </nav>
    </div>

    <div class="relative pb-2.5 sm:hidden" data-nav-fades>
      <div class="no-scrollbar flex gap-2 overflow-x-auto whitespace-nowrap" data-nav-scroll>
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class="shrink-0 rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-ink/20 hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <div
        data-fade="left"
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-linear-to-r from-paper to-transparent opacity-0 transition-opacity"
      ></div>
      <div
        data-fade="right"
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-linear-to-l from-paper to-transparent transition-opacity"
      ></div>
    </div>
  </div>
</header>

<script>
  const wrap = document.querySelector("[data-nav-fades]");
  const scroller = wrap ? wrap.querySelector<HTMLElement>("[data-nav-scroll]") : null;
  const left = wrap ? wrap.querySelector<HTMLElement>('[data-fade="left"]') : null;
  const right = wrap ? wrap.querySelector<HTMLElement>('[data-fade="right"]') : null;

  if (wrap && scroller && left && right) {
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      left.classList.toggle("opacity-0", scroller.scrollLeft <= 4);
      right.classList.toggle("opacity-0", scroller.scrollLeft >= max - 4);
    };
    scroller.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
