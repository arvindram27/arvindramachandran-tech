---
import { site } from "../data/site";

const groups = site.skills;
---

<section id="skills" aria-labelledby="skills-heading" class="border-t border-line scroll-mt-28 sm:scroll-mt-20">
  <div class="reveal mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24" data-reveal="fade">
    <div class="grid gap-8 md:grid-cols-[180px_1fr] md:gap-16">
      <div>
        <h2 id="skills-heading" class="font-mono text-sm font-medium text-muted">Skills</h2>
      </div>
      <dl class="divide-y divide-line">
        {
          groups.map((group) => (
            <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[200px_1fr] sm:items-baseline sm:gap-8">
              <dt class="font-mono text-sm text-muted">{group.category}</dt>
              <dd class="text-base leading-relaxed text-ink">{group.items.join(" · ")}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
