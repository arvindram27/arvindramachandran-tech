  github:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
} as const;
---

<section aria-labelledby="hero-name" class="mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28 sm:pb-24">
  <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-mono text-sm text-muted">{site.location}</p>
      <h1
        id="hero-name"
        class="mt-5 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl lg:text-7xl"
      >
        {site.name}
      </h1>
      <p class="mt-6 max-w-2xl font-display text-xl font-medium text-ink sm:text-2xl">
        {site.hero.positioning}
      </p>
      <p class="mt-6 font-mono text-sm text-muted" aria-label="Core stack">
        {site.hero.stack.join(" · ")}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={site.hero.ctas.primary.href}
          class="rounded-sm bg-accent px-5 py-3 text-sm font-medium text-paper hover:bg-accent-strong"
        >
          {site.hero.ctas.primary.label}
        </a>
        {
          site.hero.socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="p-1.5 text-muted hover:text-ink"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={iconPaths[social.icon]} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <aside class="hidden pb-2 md:block" aria-hidden="true">
      <svg class="w-72" viewBox="0 0 280 96" fill="none">
        <polyline
          points="0,78 28,70 52,74 80,58 104,66 132,50 156,58 184,40 208,46 232,28 256,36 280,16"
          stroke="#141412"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
        <circle cx="232" cy="28" r="6" fill="#B45309"></circle>
      </svg>
      <p class="mt-3 font-mono text-xs text-muted">PAL — Price Anomaly Locator</p>
    </aside>
  </div>
</section>
