---
import { site } from "../data/site";
---

<section aria-labelledby="hero-name" class="mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28 sm:pb-24">
  <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-mono text-sm text-muted">{site.location}</p>
      <h1
        id="hero-name"
        class="mt-5 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl lg:text-7xl"
      >
        {site.name}
      </h1>
      <p class="mt-6 max-w-2xl font-display text-xl font-medium text-ink sm:text-2xl">
        {site.hero.positioning}
      </p>
      <p class="mt-6 font-mono text-sm text-muted" aria-label="Core stack">
        {site.hero.stack.join(" · ")}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={site.hero.ctas.primary.href}
          class="rounded-sm bg-accent px-5 py-3 text-sm font-medium text-paper hover:bg-accent-strong"
        >
          {site.hero.ctas.primary.label}
        </a>
        <a
          href={site.hero.ctas.secondary.href}
          class="rounded-sm border border-line px-5 py-3 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          {site.hero.ctas.secondary.label}
        </a>
      </div>
    </div>

    <aside class="hidden pb-2 md:block" aria-hidden="true">
      <svg class="w-72" viewBox="0 0 280 96" fill="none">
        <polyline
          points="0,78 28,70 52,74 80,58 104,66 132,50 156,58 184,40 208,46 232,28 256,36 280,16"
          stroke="#141412"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
        <circle cx="232" cy="28" r="6" fill="#B45309"></circle>
      </svg>
      <p class="mt-3 font-mono text-xs text-muted">PAL — Price Anomaly Locator</p>
    </aside>
  </div>
</section>
