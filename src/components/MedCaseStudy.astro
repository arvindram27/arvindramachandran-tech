---
import { site } from "../data/site";

const planes = [site.med.architecture.live, site.med.architecture.research];
const bridge = site.med.architecture.bridge;

const [fearLine, palLine] = site.med.framing
  .split(". ")
  .map((sentence, i, all) => (i < all.length - 1 ? `${sentence}.` : sentence));
---

<section id="work" aria-labelledby="work-heading" class="border-t border-line scroll-mt-28 sm:scroll-mt-20">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="reveal grid gap-8 md:grid-cols-[180px_1fr] md:gap-16" data-reveal>
      <div>
        <p class="font-mono text-sm font-medium tabular-nums text-muted">
          <span class="text-muted/60">02</span> · Work
        </p>
      </div>
      <div>
        <p class="font-mono text-sm text-muted">{site.med.status}</p>
        <h2 id="work-heading" class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {site.med.name}
        </h2>
        <p class="mt-6 font-display text-2xl font-medium leading-snug tracking-[-0.015em] sm:text-3xl">
          <span class="text-ink">{fearLine}</span>
          <span class="text-accent"> {palLine}</span>
        </p>
        <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-muted">
          {site.med.description.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>

    <div class="reveal mt-12 space-y-8" data-reveal>
      {
        planes.map((plane) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <p class="font-mono text-xs font-medium tracking-wide text-muted uppercase">
                {plane.label}
              </p>
              <p class="font-mono text-xs text-muted">{plane.note}</p>
            </div>
            <ol class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-stretch">
              {plane.steps.map((step, i) => (
                <>
                  <li class="flex flex-col justify-between gap-1 border border-line bg-paper px-4 py-3.5 sm:min-w-0 sm:flex-1">
                    <span class="block text-sm font-medium text-ink">{step.label}</span>
                    <span class="block font-mono text-xs text-muted">{step.detail}</span>
                  </li>
                  {i < plane.steps.length - 1 && (
                    <li
                      aria-hidden="true"
                      class="flex shrink-0 items-center justify-center px-0.5 font-mono text-xs text-muted"
                    >
                      <span class="sm:hidden">↓</span>
                      <span class="hidden sm:inline">→</span>
                    </li>
                  )}
                </>
              ))}
            </ol>
          </div>
        ))
      }
      <p class="border-t border-line pt-4 font-mono text-xs text-muted">{bridge}</p>
    </div>

    <p class="reveal mt-12 font-mono text-sm text-muted" data-reveal="fade">
      <span class="font-medium text-ink">Stack</span>: {site.med.stack.join(" · ")}
    </p>

    <div class="reveal mt-6 flex flex-wrap items-center gap-6" data-reveal="fade">
      <a
        href={site.med.repoUrl}
        class="text-sm font-medium text-accent underline-offset-4 hover:text-accent-strong hover:underline"
      >
        GitHub repo
      </a>
      {
        site.med.articleUrl ? (
          <a
            href={site.med.articleUrl}
            class="text-sm font-medium text-accent underline-offset-4 hover:text-accent-strong hover:underline"
          >
            Medium deep-dive
          </a>
        ) : (
          <p class="font-mono text-sm text-muted">Medium deep-dive: coming soon</p>
        )
      }
    </div>
  </div>
</section>
