---
import { site } from "../data/site";
---

<section id="projects" aria-labelledby="projects-heading" class="border-t border-line">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="grid gap-8 md:grid-cols-[180px_1fr] md:gap-16">
      <div>
        <h2 id="projects-heading" class="font-mono text-sm font-medium text-muted">Projects</h2>
      </div>
      <div class="flex flex-col gap-6">
        {
          site.secondaryProjects.map((project) => (
            <article class="border border-line p-6 sm:p-8">
              <h3 class="font-display text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                {project.name}
              </h3>
              <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{project.description}</p>
              <a
                href={project.repoUrl}
                class="mt-5 inline-block text-sm font-medium text-accent underline-offset-4 hover:text-accent-strong hover:underline"
              >
                GitHub repo
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
