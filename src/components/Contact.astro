  linkedin:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  mail: "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z",
  whatsapp:
    "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z",
} as const;

type DirectLinkIcon = keyof typeof iconPaths;

const directLinks: { label: string; href: string; external: boolean; icon: DirectLinkIcon }[] = [
  { label: "LinkedIn", href: site.links.linkedin, external: true, icon: "linkedin" },
  { label: "GitHub", href: site.links.github, external: true, icon: "github" },
  { label: `Email — ${site.email}`, href: `mailto:${site.email}`, external: false, icon: "mail" },
  ...(contact.whatsappHref
    ? [{ label: "WhatsApp", href: contact.whatsappHref, external: true, icon: "whatsapp" as const }]
    : []),
];

const notifyFailedMessage = `Your message was saved, but the email notification failed. Please reach me directly at ${site.email}.`;
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="border-t border-line scroll-mt-28 sm:scroll-mt-20"
>
  <div
    class="reveal mx-auto grid max-w-5xl gap-8 px-4 py-16 sm:px-6 sm:py-24 md:grid-cols-[180px_1fr] md:gap-16"
    data-reveal="fade"
  >
    <div>
      <p class="font-mono text-sm font-medium text-muted">Contact</p>
    </div>
    <div>
      <h2
        id="contact-heading"
        class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        {contact.title}
      </h2>

      <div class="mt-6 flex flex-nowrap items-center gap-2">
        {
          directLinks.map((link) => (
            <a
              href={link.href}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              aria-label={link.label}
              title={link.label}
              class="p-2 text-muted hover:text-ink"
            >
              <svg
                class="h-5 w-5 sm:h-6 sm:w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={iconPaths[link.icon]} />
              </svg>
            </a>
          ))
        }
      </div>

      <form
        class="mt-10 max-w-xl"
        data-contact-form
        data-endpoint={contact.endpoint}
        data-error-message={contact.errorMessage}
        data-notify-failed-message={notifyFailedMessage}
        data-sending-label={contact.sendingLabel}
        novalidate
      >
        <div>
          <label for="contact-name" class="mb-2 block font-mono text-sm text-muted">
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            maxlength={contact.nameMaxLength}
            placeholder="Your name"
            class="w-full rounded-sm border border-line bg-paper px-4 py-3 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none"
          />
        </div>
        <div class="mt-6">
          <label for="contact-email" class="mb-2 block font-mono text-sm text-muted">
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            maxlength={contact.emailMaxLength}
            placeholder="you@example.com"
            class="w-full rounded-sm border border-line bg-paper px-4 py-3 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none"
          />
        </div>
        <div class="mt-6">
          <label for="contact-message" class="mb-2 block font-mono text-sm text-muted">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows={5}
            required
            maxlength={contact.messageMaxLength}
            placeholder="What's on your mind?"
            class="w-full rounded-sm border border-line bg-paper px-4 py-3 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none"
          ></textarea>
        </div>
        <input
          type="text"
          name={contact.honeypotField}
          data-contact-honeypot
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="sr-only"
        />
        <p data-contact-status role="status" class="mt-4 text-sm text-ink" hidden></p>
        <button
          type="submit"
          data-contact-submit
          class="mt-6 rounded-sm bg-accent px-5 py-3 text-sm font-medium text-paper hover:bg-accent-strong disabled:cursor-not-allowed disabled:opacity-60"
        >
          {contact.submitLabel}
        </button>
        <noscript>
          <p class="mt-6 text-sm text-muted">
            {contact.noscriptNote}{" "}
            <a
              href={`mailto:${site.email}`}
              class="font-medium text-accent underline-offset-4 hover:text-accent-strong hover:underline"
            >
              Email me
            </a>
          </p>
        </noscript>
      </form>
      <div data-contact-success hidden class="mt-10 max-w-xl border border-line p-8 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-line">
          <svg class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <p class="font-display text-xl font-semibold text-ink">Message sent</p>
        <p class="mt-2 text-sm text-muted">Thanks for reaching out!</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-contact-submit]");
    const success = document.querySelector<HTMLElement>("[data-contact-success]");
    const endpoint = form.dataset.endpoint ?? "/api/contact";
    const fallbackError =
      form.dataset.errorMessage ?? "Something went wrong. Please try again.";
    const notifyFailedError = form.dataset.notifyFailedMessage ?? fallbackError;
    const sendingLabel = form.dataset.sendingLabel ?? "Sending…";
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showError = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!status || !submit) return;

      const fields = new FormData(form);
      const name = String(fields.get("name") ?? "").trim();
      const email = String(fields.get("email") ?? "").trim();
      const message = String(fields.get("message") ?? "").trim();
      const honeypot = form.querySelector<HTMLInputElement>("[data-contact-honeypot]");
      const company = honeypot ? honeypot.value.trim() : "";
      const messageInput = form.querySelector<HTMLTextAreaElement>("#contact-message");
      const messageMax =
        messageInput && messageInput.maxLength > 0 ? messageInput.maxLength : 2000;

      status.hidden = true;
      status.textContent = "";

      if (!name || !email || !message) {
        showError("Please fill in your name, email, and message.");
        return;
      }
      if (!emailPattern.test(email)) {
        showError("Please enter a valid email address.");
        return;
      }
      if (message.length > messageMax) {
        showError(`Please keep your message under ${messageMax} characters.`);
        return;
      }

      const originalLabel = submit.textContent;
      submit.disabled = true;
      submit.textContent = sendingLabel;

      const restore = () => {
        submit.disabled = false;
        submit.textContent = originalLabel;
      };

      const send = async () => {
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, email, message, company }),
          });
          let body: { ok?: boolean; error?: string } | null = null;
          try {
            body = (await response.json()) as { ok?: boolean; error?: string };
          } catch {
            body = null;
          }
          if (response.ok && body && body.ok) {
            if (success) {
              form.hidden = true;
              success.hidden = false;
            }
            return;
          }
          if (body && body.error === "notify_failed") {
            showError(notifyFailedError);
          } else {
            showError(fallbackError);
          }
          restore();
        } catch {
          showError(fallbackError);
          restore();
        }
      };

      void send();
    });
  }
</script>
