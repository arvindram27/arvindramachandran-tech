.btn{display:inline-flex;align-items:center;gap:10px;border:1.5px solid var(--color-accent,#b3352c);border-radius:6px;padding:12px 18px;font-size:1rem;font-weight:600;color:var(--color-accent,#b3352c);text-decoration:none;background:#fff}
.btn:hover,.btn:focus{background:var(--color-accent,#b3352c);color:#fff;outline:none}
.btn .sz{font-weight:400;font-size:.85rem;opacity:.75}
.research{max-width:960px;margin:auto;padding:72px 24px;background:var(--color-paper,#fafaf7);color:var(--color-ink,#141412);font-family:var(--font-sans,'IBM Plex Sans',Arial,sans-serif);line-height:1.7}
.research [id]{scroll-margin-top:7rem}
h1,h2,h3{font-family:var(--font-display,'Space Grotesk','IBM Plex Sans',Arial,sans-serif);line-height:1.18}
h1{font-size:clamp(2.4rem,6.5vw,4.2rem);letter-spacing:-.04em;margin:.2em 0}
h2{font-size:1.9rem;margin:0 0 .3em}
h3{font-size:1.3rem;font-weight:500;color:var(--color-muted,#5a5a54);margin:.2em 0 1em}
p,li{font-size:1.1rem}
a{color:var(--color-accent,#b3352c);overflow-wrap:anywhere}
section{border-top:1px solid var(--color-line,#e6e4dc);padding-top:26px;margin-top:44px}
.eyebrow{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.72rem;letter-spacing:.12em;color:var(--color-accent,#b3352c)}
.kick{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.72rem;letter-spacing:.12em;color:var(--color-accent,#b3352c);margin:0 0 6px}
.lead{font-size:1.3rem}
.byline{color:var(--color-muted,#5a5a54)}
.note{font-size:.95rem;color:var(--color-muted,#5a5a54)}
.photo{margin:26px 0 6px}
.photo img{width:100%;height:auto;border-radius:6px;border:1px solid var(--color-line,#e6e4dc);display:block}
.photo figcaption{font-size:.9rem;color:var(--color-muted,#5a5a54);margin-top:8px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:26px 0 10px}
.kpi{border:1px solid var(--color-line,#e6e4dc);border-radius:6px;padding:16px 18px;background:#fff}
.kpi .big{font-family:var(--font-display,'Space Grotesk','IBM Plex Sans',Arial,sans-serif);font-size:2.1rem;font-weight:600;margin:0;color:var(--color-ink,#141412)}
.kpi .cap{font-size:.95rem;margin:.4em 0 0;color:var(--color-muted,#5a5a54)}
.chartbox{border:1px solid var(--color-line,#e6e4dc);border-radius:6px;background:#fff;padding:18px 18px 8px;margin:16px 0;overflow-x:auto}
.chartitle{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.88rem;letter-spacing:.04em;color:var(--color-muted,#5a5a54);margin:0 0 8px}
.legend{font-size:.92rem;color:var(--color-muted,#5a5a54);margin:6px 0 8px}
.sw{display:inline-block;width:11px;height:11px;border-radius:2px;margin:0 6px 0 14px;vertical-align:-1px}
.sw:first-child{margin-left:0}
.chart{width:100%;min-width:680px;height:auto;display:block}
.chart text{font-family:var(--font-sans,'IBM Plex Sans',Arial,sans-serif);fill:var(--color-ink,#141412)}
.chart .v{font-size:17px;font-weight:600}
.chart .vg{font-size:14px}
.chart .x{font-size:16px;fill:var(--color-muted,#5a5a54)}
.chart .s{font-size:15px;fill:var(--color-muted,#5a5a54)}
.chart .sysl{font-size:14px;font-weight:600}
.chart .sysc{font-size:14px;fill:var(--color-muted,#5a5a54);font-style:italic}
.chart .bar{cursor:default;outline:none}
.chart .bar:hover rect,.chart .bar:focus rect{filter:brightness(0.88)}
.chart .bar:focus rect{stroke:var(--color-ink,#141412);stroke-width:1.5}
.chart .bar:hover circle,.chart .bar:focus circle{filter:brightness(0.88)}
.chart.sys{min-width:0}
:global(.tip){position:absolute;transform:translate(-50%,-100%);background:var(--color-ink,#141412);color:#fff;font-size:.9rem;padding:6px 10px;border-radius:4px;pointer-events:none;white-space:nowrap;z-index:20}
.tabsbar{display:none;gap:8px;flex-wrap:wrap;margin:16px 0 0}
:global(.js) .tabsbar{display:flex}
.tabsbar button{border:1px solid var(--color-line,#e6e4dc);background:#fff;border-radius:20px;padding:9px 16px;font-size:1rem;font-family:inherit;cursor:pointer;color:var(--color-ink,#141412)}
.tabsbar button[aria-selected=true]{background:var(--color-ink,#141412);color:#fff;border-color:var(--color-ink,#141412)}
.tabsbar button:focus-visible{outline:2px solid var(--color-accent,#b3352c);outline-offset:2px}
:global(.js) .cpanel{display:none}
:global(.js) .cpanel.on{display:block}
.stepper{position:relative}
.tlctl{display:none;align-items:center;gap:14px;margin-top:10px}
:global(.js) .tlctl{display:flex}
:global(.js) .stepper .tl{display:none}
:global(.js) .stepper .tl.on{display:block}
.stepper{border-left:2px solid var(--color-line,#e6e4dc);margin:18px 0 8px 6px;padding-left:0}
.tl{position:relative;padding:10px 0 10px 22px}
.tl::before{content:"";position:absolute;left:-6px;top:20px;width:10px;height:10px;border-radius:50%;background:var(--color-accent,#b3352c)}
.tl .when{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.85rem;color:var(--color-muted,#5a5a54);margin:0}
.tl .what{margin:.15em 0 0;font-size:1.05rem}
.tlctl button{border:1px solid var(--color-line,#e6e4dc);background:#fff;border-radius:20px;padding:8px 16px;font-size:.95rem;font-family:inherit;cursor:pointer}
.tlctl button:focus-visible{outline:2px solid var(--color-accent,#b3352c);outline-offset:2px}
.tlcount{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.85rem;color:var(--color-muted,#5a5a54)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin:16px 0}
.cards article{border:1px solid var(--color-line,#e6e4dc);border-radius:6px;padding:16px 18px;background:#fff;margin:0}
.cards article h3{font-size:1.1rem;color:var(--color-ink,#141412);margin:0 0 .5em}
.imglink{font-size:.92rem;font-family:var(--font-mono,'IBM Plex Mono',monospace)}
.cardph{width:100%;height:150px;object-fit:cover;border-radius:4px;display:block;margin-bottom:6px}
.pcredit{font-size:.8rem;color:var(--color-muted,#5a5a54);margin:0 0 10px}
details{border:1px solid var(--color-line,#e6e4dc);border-radius:6px;background:#fff;padding:4px 18px;margin:12px 0}
summary{cursor:pointer;padding:12px 0;font-weight:600;font-size:1.05rem}
ul.ticks{padding-left:1.1em}
ul.ticks li{margin:.5em 0}
.refs p{font-size:.98rem;margin:.45em 0}
.refbar{display:none;gap:8px;flex-wrap:wrap;margin:10px 0}
:global(.js) .refbar{display:flex}
.refbar button{border:1px solid var(--color-line,#e6e4dc);background:#fff;border-radius:20px;padding:8px 15px;font-size:.95rem;font-family:inherit;cursor:pointer}
.refbar button.on{background:var(--color-ink,#141412);color:#fff;border-color:var(--color-ink,#141412)}
.refbar button:focus-visible{outline:2px solid var(--color-accent,#b3352c);outline-offset:2px}
.refcount{font-family:var(--font-mono,'IBM Plex Mono',monospace);font-size:.85rem;color:var(--color-muted,#5a5a54);align-self:center}
table{border-collapse:collapse;width:100%;font-size:15px;background:#fff}
td,th{text-align:left;padding:8px 6px;border-bottom:1px solid var(--color-line,#e6e4dc)}
.closing{display:grid;grid-template-columns:minmax(220px,300px) 1fr;gap:30px;align-items:start}
.badgeph{margin:0}
.badgeph img{width:100%;height:auto;border-radius:6px;border:2px solid var(--color-gold,#a3832f);display:block}
.badgeph figcaption{font-size:.9rem;color:var(--color-muted,#5a5a54);margin-top:8px}
@media(max-width:720px){.closing{grid-template-columns:1fr}.badgeph{max-width:340px}}
@media(min-width:721px){
p,li{font-size:1.15rem}
.lead{font-size:1.4rem}
.note{font-size:1rem}
.eyebrow,.kick{font-size:.95rem}
.photo figcaption,.badgeph figcaption{font-size:.95rem}
.pcredit{font-size:.94rem}
.kpi .cap{font-size:1rem}
.chartitle{font-size:.95rem}
.legend{font-size:.98rem}
.imglink{font-size:.98rem}
.cards article h3{font-size:1.15rem}
.tl .what{font-size:1.1rem}
.tl .when,.tlcount{font-size:.94rem}
.tlctl button{font-size:1rem}
.tabsbar button{font-size:1.05rem}
.btn .sz{font-size:.95rem}
summary{font-size:1.1rem}
.refs p{font-size:1.05rem}
}
footer{margin-top:56px;padding-top:22px;border-top:1px solid var(--color-line,#e6e4dc)}
footer p{font-size:1rem;color:var(--color-muted,#5a5a54)}
@media(max-width:720px){.research{padding:44px 18px}h2{font-size:1.55rem}.kpi .big{font-size:1.7rem}p,li{font-size:1rem}.tl .what{font-size:1rem}}
@media(prefers-reduced-motion:reduce){*{transition:none}}
</style>

<script is:inline>
document.documentElement.classList.add('js');
(function(){
  // chart tabs
  var tabs=[].slice.call(document.querySelectorAll('.tabsbar [role=tab]'));
  function show(id){tabs.forEach(function(b){var on=b.getAttribute('data-t')===id;b.setAttribute('aria-selected',on);document.getElementById(b.getAttribute('data-t')).classList.toggle('on',on);});}
  tabs.forEach(function(b,i){b.addEventListener('click',function(){show(b.getAttribute('data-t'));});
    b.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key==='ArrowLeft'){var n=(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;tabs[n].focus();show(tabs[n].getAttribute('data-t'));e.preventDefault();}});});
  // timeline stepper
  var st=document.querySelector('.stepper');
  if(st){var items=[].slice.call(st.querySelectorAll('.tl')),cur=0;
    var cnt=st.querySelector('.tlcount');
    function go(n){cur=(n+items.length)%items.length;items.forEach(function(el,i){el.classList.toggle('on',i===cur);});cnt.textContent=(cur+1)+' of '+items.length;}
    st.querySelector('.tlprev').addEventListener('click',function(){go(cur-1);});
    st.querySelector('.tlnext').addEventListener('click',function(){go(cur+1);});
    go(0);}
  // references filter
  var rf=[].slice.call(document.querySelectorAll('.refbar [data-f]'));
  var rc=document.querySelector('.refcount');
  rf.forEach(function(b){b.addEventListener('click',function(){var f=b.getAttribute('data-f');
    rf.forEach(function(x){x.classList.toggle('on',x===b);});
    var n=0;[].slice.call(document.querySelectorAll('.refs .ref')).forEach(function(p){var on=f==='all'||p.classList.contains(f);p.style.display=on?'':'none';if(on)n++;});
    if(rc)rc.textContent=n+' shown';});});
  // value tooltips for chart marks
  var tip=document.createElement('div');tip.className='tip';tip.hidden=true;document.body.appendChild(tip);
  function place(g){var t=g.querySelector('title');if(!t)return;tip.textContent=g.getAttribute('aria-label')||t.textContent;tip.hidden=false;
    var r=g.getBoundingClientRect();tip.style.left=(r.left+r.width/2+window.scrollX)+'px';tip.style.top=(r.top+window.scrollY-8)+'px';}
  function hide(){tip.hidden=true;}
  document.addEventListener('mouseover',function(e){var g=e.target.closest?e.target.closest('.bar'):null;if(g)place(g);});
  document.addEventListener('mouseout',function(e){if(e.target.closest&&e.target.closest('.bar'))hide();});
  document.addEventListener('focusin',function(e){var g=e.target.closest?e.target.closest('.bar'):null;if(g)place(g);});
  document.addEventListener('focusout',function(e){if(e.target.closest&&e.target.closest('.bar'))hide();});
})();
</script>
</Base>
