---
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Path under /public for the social card, e.g. "/og/default.png". */
  image?: string;
  type?: "website" | "article" | "profile";
  /** One object or an array of schema.org JSON-LD objects, rendered as separate scripts. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Render the page without the site header and footer (used by the 404 route). */
  bare?: boolean;
  /** Ask crawlers not to index this page (used by the 404 route). */
  noindex?: boolean;
}

const SEO_DESCRIPTION =
  "Data engineer in Chennai building MED, a multi-agent financial intelligence system measuring Price Adjustment Latency. Python, SQL, Databricks, LangGraph.";

const OG_IMAGE = "/og/default.png";
const OG_IMAGE_ALT = "Arvind Ramachandran, Data Engineer in Chennai";

const {
  title,
  description = SEO_DESCRIPTION,
  image = OG_IMAGE,
  type = "website",
  jsonLd = [],
  bare = false,
  noindex = false,
} = Astro.props;

const pageTitle = title ?? `${site.name} · ${site.hero.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
const jsonLdBlocks = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAFAF7" />
    {/* Search-engine ownership verification. Bump or replace when a property is re-verified. */}
    <meta name="google-site-verification" content="I1ChD0AgyTxsjZPVwbhfwrY_PwptnQsf0btfGPGXh5I" />
    <meta name="msvalidate.01" content="1F570C74A708C96B1A69217BEDE67CBA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    {/* TODO(owner): add twitter:site / twitter:creator once a public X handle exists. */}
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-ink focus:outline-2 focus:outline-accent"
    >
      Skip to content
    </a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      const revealables = document.querySelectorAll("[data-reveal]");

      if (
        revealables.length > 0 &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        for (const el of revealables) el.classList.add("reveal-hidden");

        const reveal = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.remove("reveal-hidden");
                entry.target.classList.add("reveal-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        for (const el of revealables) reveal.observe(el);
      }
    </script>
  </body>
</html>
