{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arvindramachandran-tech",
  "main": "./src/worker.ts",
  // Keep within ~30 days; update periodically.
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
